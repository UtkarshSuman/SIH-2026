# Copy this to .env (same folder) and fill in your real values.
# .env is gitignored — never commit it.

# ---- Supabase -------------------------------------------------------
# Project URL from Supabase > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key — safe to expose in browser JS (RLS enforces access)
SUPABASE_ANON_KEY=your-supabase-anon-key

# service-role key — NEVER ship this to the browser; used only in
# alert_service.py server-side to bypass RLS for subscribers/alert_log
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Firebase / FCM -------------------------------------------------
# Path to your Firebase service-account JSON (keep in secrets/, gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# VAPID public key — from Firebase Console > Project Settings > Cloud Messaging
# > Web configuration > Web Push certificates > Key pair
# Firebase manages the private key internally; you only need the public key here.
VAPID_PUBLIC_KEY=your-vapid-public-key-from-firebase-cloud-messaging

# Firebase Web App config (from Firebase console > Project settings > Web app)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- hazard_platform bridge -----------------------------------------
# Base URL of the running hazard_platform FastAPI instance
HAZARD_PLATFORM_BASE_URL=http://localhost:8000

# How often (seconds) the classification bridge re-polls all known zones.
# 3600 = 1 hour; lower it for demos.
BRIDGE_POLL_INTERVAL_SECONDS=3600

# ---- CORS -----------------------------------------------------------
# Comma-separated allowed origins for the alert signup API.
# Use '*' only for local dev; set a real origin before deploying.
ALERT_API_CORS_ORIGINS=*
