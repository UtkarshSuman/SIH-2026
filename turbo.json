{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "BACKEND2_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "REQUIRE_EMAIL_VERIFICATION",
    "BREVO_API_KEY",
    "BREVO_SENDER_EMAIL",
    "BREVO_SENDER_NAME",
    "FAST2SMS_API_KEY",
    "ML_SERVICE_URL",
    "ML_SERVICE_API_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_ML_SERVICE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "generate": { "cache": false },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "type-check": { "dependsOn": ["^type-check"] },
    "clean": { "cache": false },
    "db:generate": { "cache": false }
  }
}